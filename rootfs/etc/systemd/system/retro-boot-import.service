[Unit]
Description=AtomStick Retro: ROMs von der RETRO-Partition übernehmen
After=local-fs.target retro-firstboot.service
Before=retroarch.service
ConditionPathIsMountPoint=/boot/retro

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/retro-import /boot/retro

[Install]
WantedBy=multi-user.target
